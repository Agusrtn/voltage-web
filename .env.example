# URL pública del proyecto Supabase (no incluye secretos)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Clave publishable/anon pública de Supabase. Nunca use service_role aquí.
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_with_your_public_key
# Zona horaria IANA que muestra la guía. Opcional; por defecto Europe/Madrid.
VITE_APP_TIMEZONE=Europe/Madrid
